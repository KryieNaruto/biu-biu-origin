<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!--
    AUTOGENERATED BY GODOT. 引擎 4.7.2 的「构建解决方案」流程在当前环境不落盘（见 ARCHITECTURE.md §0 / §11），
    因此本文件按 Godot.NET.Sdk/4.7.2 标准模板手工建立。不要手删；引擎若重新生成，内容应等价。
    规则来源: AGENTS.md §5 目录契约、docs/rules/02-tech-selection.md §3.4。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Game</RootNamespace>
    <AssemblyName>BiuBiuOrigin</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 求值阶段先剔掉；target 阶段的默认项由下面的 Target 再兜底一次。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**;tests/**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**;tmp/**;build/**;out/**</DefaultItemExcludes>
    <!--
      ★ 2026-11-04：排除**任意深度**的 obj/bin（之前只排了 .godot/mono/temp/obj）。
      Godot.NET.Sdk 会把中间产物放到 `.godot/mono/temp/obj/**`，而 MSBuild 的 `GenerateAssemblyInfo`
      在该目录写出的 `BiuBiuOrigin.AssemblyInfo.cs` / `*AssemblyAttributes.cs` 一旦在求值阶段被
      默认 glob（**/*.cs）收进 @(Compile)，就会出现 CS0579「特性重复」——而且是**自举式**的：
      上一次构建生成的 AssemblyInfo 被这次构建当源码编进来。
      target 阶段的 <Compile Remove> 来不及救这种情况（SDK 在 target 里还会再兜一次），
      所以必须在这里（求值阶段，DefaultItemExcludes）剔除。
      tools/** 里可能有独立的 .NET 小工程（如 tools/dungeon_check），它们自身的 bin/obj 同理。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    默认 glob（**/*.cs）会二次编译三类"别人的生成物"，必须排除：
      .godot/**  —— MSBuild / Godot 产物（obj/Debug/*.AssemblyInfo.cs）→ CS0579 特性重复
      tests/**   —— 测试工程源码（含 MSTest 特性）→ CS0234/CS0246
      tools/**、tmp/** —— 工具与临时目录里的独立工程/生成物
    ⚠ 经验：<Compile Remove> 放在 Project 级 ItemGroup 里**不生效**——Godot.NET.Sdk 在
    target 阶段才把默认项加进 @(Compile)。所以这里用 Target 在 CoreCompile 之前再剔一次。
    见 docs/architecture/ECS.md §10（测试必须在不依赖 Godot 的进程里跑）。
  -->
  <Target Name="BiuBiuOrigin_ExcludeNonGameplaySources"
          BeforeTargets="CoreCompile"
          Condition="'$(ManagePackageVersionsCentrally)' != 'true'">
    <ItemGroup>
      <Compile Remove=".godot/**/*.cs" />
      <Compile Remove="tests/**/*.cs" />
      <Compile Remove="tools/**/*.cs" />
      <Compile Remove="tmp/**/*.cs" />
      <Compile Remove="obj/**/*.cs" />
      <Compile Remove="bin/**/*.cs" />
      <Compile Remove="**/obj/**/*.cs" />
      <Compile Remove="**/bin/**/*.cs" />
    </ItemGroup>
  </Target>
</Project>
