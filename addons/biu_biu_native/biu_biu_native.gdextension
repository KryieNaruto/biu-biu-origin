; =============================================================================
;  biu_biu_native.gdextension
;  Emitted by native/CMakeLists.txt; DLLs land in addons/biu_biu_native/bin/.
;
;  NOTE: this file must use the SPLIT form -- [configuration] on its own line,
;  then entry_symbol. Writing "configuration/entry_symbol = ..." on one line
;  makes --import fail.
;
;  KEEP THIS FILE PURE ASCII. It is parsed by the engine as a raw byte stream
;  (not as UTF-8). Non-ASCII comment bytes were the cause of a silently broken
;  parse on 2026-11-09: a trailing multi-byte char swallowed the newline, so
;  "[configuration]" ended up glued to the comment line and the whole section
;  header was lost -- which surfaced as
;  "Can't open GDExtension dynamic library".
; =============================================================================
[configuration]

entry_symbol = "biu_biu_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/biu_biu_native/bin/biu_biu_native.windows.Debug.x86_64.dll"
windows.release.x86_64 = "res://addons/biu_biu_native/bin/biu_biu_native.windows.Release.x86_64.dll"
