<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BiuBiuOrigin test project - docs/architecture/ECS.md section 10.

    WHY THIS IS NOT A ProjectReference TO BiuBiuOrigin.csproj
    =========================================================
    The layering guard below asserts that Game.Core sources contain ZERO "using Godot".
    A ProjectReference to the main project (Sdk=Godot.NET.Sdk/4.7.2) drags the whole
    GodotSharp reference closure into this assembly and the test host would need the
    engine marshalling layer - i.e. the suite could no longer prove "Game.Core is
    engine-free and testable without Godot" (the hard constraint in ECS.md section 10).
    Instead this project compiles the exact same engine-free Game.Core sources
    (scripts/core/**) as source files. They are stamped with the same AssemblyName as
    the main assembly, so namespaces, types and InternalsVisibleTo behave identically.

    The Godot-coupled layers (scripts/core/** excluded: host, actor, combat, ...) are
    verified by `dotnet build` of the main project, which check_all.ps1 runs for both
    the default and the "Host" configuration.

    The tests project must ONLY reference scripts/core/**. Adding anything else here
    would silently let Godot types in; Game_Core_Layering.cs guards against that.

    Packages come from the local NuGet cache through the repo-root nuget.config, which
    clears every remote source. Restore therefore works offline on this machine:
      Microsoft.NET.Test.Sdk 18.4.0 / MSTest.TestAdapter 4.2.1 / MSTest.TestFramework 4.2.1
    -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Game.Tests</RootNamespace>
    <AssemblyName>BiuBiuOrigin.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Same assembly identity as the main project: the Game.Core sources are shared, not
      duplicated, and they are internal-friendly (InternalsVisibleTo declarations inside
      scripts/core must keep resolving when the sources are recompiled here).
      EnableDynamicLoading is deliberately FALSE: no runtimeconfig for a Godot assembly.
    -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);MSTEST0037</NoWarn>

    <!--
      Single source of truth for "which files belong to Game.Core". The main project
      uses the same glob (see the ARCH-OK block in BiuBiuOrigin.csproj). If one side
      changes, the other must change with it; the layering guard cross-checks by
      scanning the SOURCE TREE, not by comparing file lists, so a drift cannot hide.
    -->
    <CoreSourceGlob>..\scripts\core\**\*.cs</CoreSourceGlob>

    <!--
      ★ 2026-11-04 角色抽象任务：角色系统族（装配 / 意图 / 技能门控）与数值包仓库仅依赖
      Game.Core.Ecs + Game.Core.Skills（零 Godot、零 Resource），因此可以和 core 一起在本工程里
      直接编译并做单元测试 —— 这保证了「ECS 组合玩家/怪物」这套逻辑可以在没有引擎的进程里被证明。
      若将来这些文件里出现 `using Godot` 或继承 Godot 类型，本工程会直接编译失败，
      这本身就是一道额外守卫（比人工审查更硬）。
    -->
    <CharacterSourceGlob>..\scripts\actor\**\*.cs</CharacterSourceGlob>
    <CharacterSourceGlob2>..\scripts\skill\**\*.cs</CharacterSourceGlob2>
    <CharacterSourceGlob3>..\scripts\data\StatPackageRepository.cs</CharacterSourceGlob3>
    <CharacterSourceGlob4>..\scripts\data\CharacterContentSet.cs</CharacterSourceGlob4>

    <!--
      ★ 2026-11-06 基础物件抽象任务：数据层绑定器（ContentBinder / ValueRefParser）。
      它们只依赖 Game.Core.Content + Game.Core.Actors（零 Godot、零 Resource），因此和 core 一起
      编译；这样「Excel → 运行时对象」这条链可以拿真 xlsx 在没有引擎的进程里被证明。
      若这里出现 `using Godot`，本工程会直接编译失败 —— 与 CharacterSourceGlob 同一道守卫。
    -->
    <ContentSourceGlob>..\scripts\data\Content\**\*.cs</ContentSourceGlob>

    <!--
      ★ 2026-11-06 基础物件抽象任务：战斗系统族（组件 / 熔炉 / 寄存器 / 铸造系统 / 工厂 / 弹道推进）。
      它们只依赖 Game.Core + Game.Core.Content + Game.Core.Ecs + Game.Core.Actors（零 Godot、零 Game.Host），
      所以能和 core 一起在本工程里编译并裸测 —— 「工厂造出的实体长什么样」「熔炉选谁」这些断言
      不需要启动引擎就能被证明。若这里出现 `using Godot`，本工程会直接编译失败，
      与 CharacterSourceGlob / ContentSourceGlob 是同一道守卫（比人工审查更硬）。
    -->
    <CombatSourceGlob>..\scripts\combat\**\*.cs</CombatSourceGlob>

    <!--
      ★ 2026-11-05 hero-1「第一个人物」任务：为了让「4 个变体 + 装配清单 + 移动/瞄准/射击/子弹」
      这套**纯逻辑**能在没有引擎的进程里被证明，下面三组源文件也编进本工程。
      它们全部零 Godot 依赖；一旦有人往里面加 `using Godot`，本工程会直接编译失败（硬守卫）。
      - CharacterAssemblySpec.cs  装配清单 / 变体 / 外观·镜头·手柄·武器包 + 外键校验（需求6）
      - scripts/combat/**         投射物飞行、命中检测、命中事件（需求4）
      - scripts/skill/**          技能门控 + 射击技能（需求4）
      契约：docs/design/character-hud-contract.md §8（验收必须在无引擎进程里可跑）。
    -->
    <CharacterSourceGlob5>..\scripts\data\CharacterAssemblySpec.cs</CharacterSourceGlob5>
    <CompositionSourceGlob>..\scripts\host\composition\**\*.cs</CompositionSourceGlob>
  </PropertyGroup>

  <ItemGroup>
    <!-- Engine-free Game.Core sources (the system under test). -->
    <Compile Include="$(CoreSourceGlob)" Link="Game.Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(CharacterSourceGlob)" Link="Game.Character\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(CharacterSourceGlob2)" Link="Game.Skill\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(CharacterSourceGlob3)" Link="Game.Data\%(Filename)%(Extension)" />
    <Compile Include="$(CharacterSourceGlob4)" Link="Game.Data\%(Filename)%(Extension)" />
    <Compile Include="$(ContentSourceGlob)" Link="Game.Data.Content\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(CombatSourceGlob)" Link="Game.Combat\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(CharacterSourceGlob5)" Link="Game.Data\%(Filename)%(Extension)" />
    <!--
      ★ 组合根里**纯逻辑**的那部分（技能工厂 / 技能包实例化）。
      为什么要编进来：`EndToEnd_PressingPrimarySpawnsRealProjectile` 的本质断言是
      「数据行 → 真技能 → 真子弹」这条链**在宿主的工厂上**是通的。工厂若不在本工程里编译，
      测试就只能测到数据层的 DataSkill 占位，红着也是红、绿了也说明不了宿主接线正确。
      该目录不含任何 `using Godot`（一旦有，本工程立刻编译失败 —— 硬守卫）。
    -->
    <Compile Include="$(CompositionSourceGlob)" Link="Game.Host.Composition\%(RecursiveDir)%(Filename)%(Extension)" />

    <!--
      No generated code is expected inside scripts/core yet. If a future change adds a
      source generator output there, it must be reviewed for Godot types BEFORE being
      added to this list.
    -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.1" />
  </ItemGroup>

  <!--
    Test outputs go to tests/bin + tests/obj on purpose: the architecture guard's ignore
    list already excludes bin/** and obj/**, so the MSTest DLLs are never scanned.
  -->
</Project>
