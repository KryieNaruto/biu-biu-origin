<?xml version="1.0" encoding="utf-8"?>
<!--
    BiuBiuOrigin 离线 NuGet 源配置（AGENTS.md §6：本机 NuGet 只能走本地离线源）。
    只在这里登记源；Godot.NET.Sdk / GodotSharp / Godot.SourceGenerators 全部来自 E:\Godot\GodotSharp\Tools\nupkgs。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-offline" value="E:\Godot\GodotSharp\Tools\nupkgs" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
